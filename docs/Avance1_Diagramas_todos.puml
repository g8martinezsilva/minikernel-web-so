  usecase "CU-04\nVerificar estado seguro (Banquero)" as CU04
  usecase "CU-05\nAsignar memoria" as CU05
  usecase "CU-06\nLiberar memoria y analizar fragmentación" as CU06
  usecase "CU-07\nGestionar archivos y directorios (CRUD)" as CU07
  usecase "CU-08\nFormatear el sistema de archivos" as CU08
  usecase "CU-09\nPlanificar el brazo de disco" as CU09
  usecase "CU-10\nTransferir datos por DMA con interrupción" as CU10
  usecase "CU-11\nEnviar y recibir paquetes (socket simulado)" as CU11
  usecase "CU-12\nAutenticar usuario" as CU12
  usecase "CU-13\nVerificar permisos (ACL)" as CU13
