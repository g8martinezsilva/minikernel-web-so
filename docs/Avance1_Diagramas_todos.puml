@startuml
title Arquitectura en capas del minikernel
skinparam shadowing false
skinparam componentStyle rectangle
package "Cliente web (HTML5 + JavaScript)" {
  [Paneles: Procesos, Memoria, Archivos, E/S, Seguridad] as UI
  [Consola de logs y controles] as CON
}
package "API Spring Boot (STOMP / REST)" {
  [Controladores REST y WebSocket] as API
}
package "Servidores en espacio de usuario" {
  [ProcessServer] as PS
  [MemoryServer] as MS
  [FileServer] as FS
  [IOServer] as IOS
  [SecurityServer] as SS
}
package "Microkernel" {
  [Scheduler] as SCH
  [Kernel (IPC / IPCMessage)] as KER
  [InterruptController] as IC
}
package "Hardware simulado" {
  [CPU y reloj] as CPU
  [RAM] as RAM
  [Disco] as DSK
  [DMA y NIC] as DMA
}
UI --> API
CON --> API
API --> KER : IPCMessage
KER <--> PS : IPCMessage
KER <--> MS : IPCMessage
KER <--> FS : IPCMessage
KER <--> IOS : IPCMessage
KER <--> SS : IPCMessage
KER --> SCH
KER --> IC
SCH --> CPU
MS --> RAM
IOS --> DSK
IOS --> DMA
DMA ..> IC : interrupción
@enduml@startuml
